# x402gate environment variables
# Copy this file to .env and fill in your values.

# WaveSpeed AI API key (https://wavespeed.ai/accesskey)
WAVESPEED_API_KEY=your_wavespeed_api_key_here

# OpenRouter API key (https://openrouter.ai/settings/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Base (EVM): Wallet address to receive USDC payments
BASE_PAY_TO_ADDRESS=0xYourWalletAddressHere

# Base (EVM): Private key for settling payments on-chain (needs ETH for gas)
BASE_FACILITATOR_PRIVATE_KEY=your_facilitator_private_key_here

# Solana: Wallet address to receive USDC payments (base58)
SOLANA_PAY_TO_ADDRESS=YourSolanaWalletAddressHere

# Solana: Private key for settling payments (base58 encoded, needs SOL for gas)
SOLANA_FACILITATOR_PRIVATE_KEY=your_solana_private_key_here

# Solana: RPC URL (free key at https://dashboard.helius.dev)
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your_helius_key_here

# [Optional] E2E test keys (must hold USDC, must be DIFFERENT from facilitator)
# BASE_E2ETEST_PRIVATE_KEY=0x...
# SOLANA_E2ETEST_PRIVATE_KEY=base58...

# [Optional] Public base URL of this instance (used in AI agent discovery endpoints)
# BASE_URL=https://x402gate-production.up.railway.app
